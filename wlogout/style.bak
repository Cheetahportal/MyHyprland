/* Make the background of the whole screen transparent */
window {
    background-color: rgba(0, 0, 0, 0.0); /* Fully transparent */
}

/* Style for each logout button */
button {
    background-color: black;      /* Button background */
    color: white;
    border: 10px solid white;
    border-radius: 20px;          /* Rounded corners (optional) */
    border: none;                 /* No border */
    margin: 10px;                 /* Space around buttons */
    padding: 10px;                /* Space inside buttons */
    font-size: 32px;              /* Icon size */
    transition: all 0.3s ease;    /* Smooth hover effect */
}

/* Hover state: invert colors */
button:hover {
    background-color: white;     /* Background on hover */
    color: black;                /* Icon color on hover */
}

/* Optional: make icons smoother */
button image {
    transition: all 0.3s ease;
}

